# Flowlet — local development environment
# Copy to .env and fill in real values. Never commit .env.
# All values below are placeholders for local development only.

# Backend (Bun). The brief fixes the backend port at 4000.
PORT=4000
NODE_ENV=development

# PostgreSQL — run history lives here.
# `docker compose up -d` starts one; see README for the local route.
DATABASE_URL=postgresql://flowlet:CHANGE_ME@localhost:5432/flowlet_dev

# MongoDB — flow definitions live here.
# `docker compose up -d` starts one.
MONGODB_URI=mongodb://localhost:27017/flowlet_dev
MONGODB_DB=flowlet_dev

# Frontend — the browser talks to the backend at this URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
